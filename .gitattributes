# Normalize line endings across platforms
* text=auto

# Keep these as LF
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.html text eol=lf
*.css text eol=lf
*.d.ts text eol=lf

# Binary assets
*.exe binary
*.dll binary
*.gz binary
*.png binary
*.jpg binary
